# Demo mode is read-only and uses synthetic in-repository data.
HMS_DATA_MODE=demo

# Required only after the Supabase schema, RLS policies, and auth workflows are installed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon-key name remains supported if your Supabase project uses it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
